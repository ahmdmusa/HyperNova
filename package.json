{
  "name": "hypernova",
  "version": "3.0.0",
  "description": "HyperNova - Next-Gen Ambient Dynamic Island for Desktop",
  "homepage": "https://github.com/ahmdmusa/HyperNova",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmdmusa/HyperNova.git"
  },
  "main": "nova.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:store": "electron-builder --win appx"
  },
  "author": {
    "name": "Ahmed Musa",
    "url": "https://github.com/ahmdmusa"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.ahmdmusa.hypernova",
    "productName": "HyperNova",
    "copyright": "Copyright © 2026 Ahmed Musa (ahmdmusa)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "sounds/**/*",
      "build/icon.png",
      "build/icon.ico",
      "!promo/**",
      "!screenshots/**",
      "!dist/**",
      "!src-tauri/**",
      "!ui/**",
      "!*.cmd",
      "!setup-log.txt",
      "!verify_*.js",
      "!test_*.js",
      "!**/*.map",
      "!helper/*.cs",
      "!helper/*.cmd"
    ],
    "publish": {
      "provider": "github",
      "owner": "ahmdmusa",
      "repo": "HyperNova"
    },
    "asarUnpack": [
      "helper/nova-helper.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "HyperNova"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "artifactName": "HyperNova-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HyperNova",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "HyperNova-Portable-${version}.${ext}"
    },
    "appx": {
      "applicationId": "HyperNovaDynamicIsland",
      "identityName": "AhmedMusa.HyperNova",
      "publisher": "CN=AhmedMusa",
      "publisherDisplayName": "Ahmed Musa",
      "artifactName": "HyperNova-Store-${version}.${ext}",
      "showNameOnTiles": true,
      "backgroundColor": "#0c0d14",
      "languages": [
        "ar",
        "en"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  }
}
