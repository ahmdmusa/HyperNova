{
  "name": "nova-island",
  "version": "2.0.0",
  "description": "HyperNova - Next-Gen Ambient Dynamic Island for Desktop",
  "main": "nova.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "Ahmed Mousa & Contributors (built upon foundational work by Amr)",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.dynamicnova.app",
    "productName": "HyperNova",
    "copyright": "Copyright © 2026 Nova Island by AmerTech",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "build/icon.png",
      "build/icon.ico",
      "!promo/**",
      "!dist/**",
      "!*.cmd",
      "!setup-log.txt",
      "!**/*.map",
      "!helper/*.cs",
      "!helper/*.cmd"
    ],
    "publish": {
      "provider": "github",
      "owner": "NOVA-TECH-KIT",
      "repo": "nova-island"
    },
    "asarUnpack": [
      "helper/nova-helper.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Nova Island"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Nova-Island-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HyperNova",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Nova Island ${version} portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  }
}